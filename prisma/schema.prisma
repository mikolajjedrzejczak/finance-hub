generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum InvoiceStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  OVERDUE
}

enum Currency {
  PLN
  // EUR
  // USD
  // GBP
}

enum PaymentMethod {
  TRANSFER
  CASH
  CARD
  OTHER
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  emailVerified DateTime?
  image         String?
  name          String?
  password      String?
  clients       Client[]
  auditLogs     AuditLog[]
  services      Service[]
  invoices      Invoice[]
  accounts      Account[]
  sessions      Session[]
  companies     Company[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id          String    @id @default(uuid())
  name        String
  nip         String
  city        String
  postal      String
  address     String
  email       String?
  phone       String?
  bankAccount String?
  invoices    Invoice[]

  userId    String
  companyId String
  company   Company @relation(fields: [userId, companyId], references: [userId, id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@unique([companyId, name])
  @@unique([companyId, nip])
  @@unique([companyId, id])
}

model Invoice {
  id            String        @id @default(uuid())
  number        String
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  status        InvoiceStatus @default(PENDING)
  totalNet      Decimal       @db.Decimal(12, 2)
  totalGross    Decimal       @db.Decimal(12, 2)
  paidAmount    Decimal       @default(0.00) @db.Decimal(12, 2)
  currency      Currency      @default(PLN)
  exchangeRate  Decimal       @default(1.000) @db.Decimal(10, 4)
  paymentMethod PaymentMethod @default(TRANSFER)
  items         InvoiceItem[]

  sellerName        String
  sellerNip         String
  sellerAddress     String
  sellerPostal      String
  sellerCity        String
  sellerBankAccount String?

  buyerName    String
  buyerNip     String
  buyerAddress String
  buyerPostal  String
  buyerCity    String

  userId    String
  clientId  String
  companyId String
  user      User    @relation(fields: [userId], references: [id])
  client    Client  @relation(fields: [companyId, clientId], references: [companyId, id])
  company   Company @relation(fields: [userId, companyId], references: [userId, id])

  payments  Payment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([companyId, number])
  @@index([clientId])
  @@index([companyId])
  @@index([issueDate])
  @@index([status])
  @@index([dueDate])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  description String
  quantity    Decimal @db.Decimal(10, 2)
  priceNet    Decimal @db.Decimal(10, 2)
  vatRate     Decimal @db.Decimal(5, 2)

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Service {
  id          String        @id @default(uuid())
  name        String
  description String?
  priceNet    Decimal       @db.Decimal(10, 2)
  vatRate     Decimal       @db.Decimal(5, 2)
  items       InvoiceItem[]

  isActive Boolean @default(true)
  category String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model Payment {
  id        String        @id @default(uuid())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod
  date      DateTime      @default(now())
  reference String?

  @@index([invoiceId])
  @@index([date])
}

model Company {
  id          String  @id @default(uuid())
  name        String
  nip         String  @unique
  city        String
  postal      String
  address     String
  email       String?
  phone       String?
  bankAccount String?
  isDefault   Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  clients  Client[]
  invoices Invoice[]
  services Service[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, id])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String?
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
